#pragma once

// Wrapper around <string> that provides std::to_string shims for old toolchains.
// In host/macOS builds (VEX not defined), defer to the standard <string> without shims.

#if !defined(VEX)
#include_next <string>
#else
#include_next <string>
#include <sstream>

#if defined(VEX_ADD_TO_STRING_SHIM)
namespace std
{

    inline std::string to_string(int value)
    {
        std::ostringstream oss;
        oss << value;
        return oss.str();
    }
    inline std::string to_string(long value)
    {
        std::ostringstream oss;
        oss << value;
        return oss.str();
    }
    inline std::string to_string(long long value)
    {
        std::ostringstream oss;
        oss << value;
        return oss.str();
    }
    inline std::string to_string(unsigned value)
    {
        std::ostringstream oss;
        oss << value;
        return oss.str();
    }
    inline std::string to_string(unsigned long value)
    {
        std::ostringstream oss;
        oss << value;
        return oss.str();
    }
    inline std::string to_string(unsigned long long value)
    {
        std::ostringstream oss;
        oss << value;
        return oss.str();
    }
    inline std::string to_string(float value)
    {
        std::ostringstream oss;
        oss << value;
        return oss.str();
    }
    inline std::string to_string(double value)
    {
        std::ostringstream oss;
        oss << value;
        return oss.str();
    }
    inline std::string to_string(long double value)
    {
        std::ostringstream oss;
        oss << value;
        return oss.str();
    }

} // namespace std
#endif
#endif
